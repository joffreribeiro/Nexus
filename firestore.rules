rules_version = '2';

// firestore.rules — regras ATIVAS do Controle-Estoque (projeto "estoquefi").
//
// Este arquivo é a fonte de verdade e deve ser publicado com:
//     firebase deploy --only firestore:rules
//
// Modelo de permissão (espelha o que o app já faz no cliente):
//   - Ler   : qualquer usuário autenticado.
//   - Gravar: apenas administradores.
//
// Por que isso importa: hoje o controle de admin é só no navegador —
// `isCurrentUserAdmin()` (app2.js) lê o flag de `localStorage`, e todos os
// ~55 `requireAdminOrNotify()` do app dependem dele. Qualquer usuário logado
// consegue contornar isso pelo DevTools. Estas regras são a única barreira
// que o cliente não tem como burlar.

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    // Admin de verdade é a custom claim, gravada por scripts/set-admin-claim.js.
    //
    // O segundo braço replica o fallback por e-mail que existe em app2.js
    // ("Fallback por email (temporário)") — sem ele, publicar estas regras
    // tira o acesso de escrita do dono enquanto a claim não estiver definida
    // na conta. Assim que `admin: true` estiver confirmada, remova o fallback
    // aqui e a linha correspondente no app2.js.
    //
    // NÃO exigir `email_verified` aqui é deliberado. A primeira versão destas
    // regras exigia, e o resultado foi bloquear justamente o dono: a conta
    // dele existe com `emailVerified: false`, então nem a claim (ainda não
    // definida) nem o fallback funcionavam — ninguém conseguia gravar.
    // A proteção que `email_verified` daria (impedir que alguém registre uma
    // conta com este mesmo e-mail para herdar privilégio) já é garantida pelo
    // próprio Firebase Auth: o endereço está tomado pela conta real e o
    // provedor de senha não permite duplicata.
    //
    // `token.get(chave, padrão)` em vez de `token.admin`: contas sem a claim
    // não têm a propriedade, e o acesso direto gera ruído de "Property admin
    // is undefined" na avaliação.
    function ehAdmin() {
      return autenticado() && (
        request.auth.token.get('admin', false) == true
        || request.auth.token.get('email', '') == 'joffre.ribeiro@gmail.com'
      );
    }

    // Estado da aplicação. Hoje é um único documento (`latest`) contendo
    // estoque, CRM, ponto e propostas — ver salvarNoCloud() em app2.js.
    // O padrão {docId} já cobre a eventual quebra desse documento em vários.
    match /app_data/{docId} {
      allow read:  if autenticado();
      allow write: if ehAdmin();
    }

    // `app_data` é a única coleção que o app usa. Tudo o mais é negado por
    // padrão — inclusive coleções criadas por engano ou por testes. Ao
    // adicionar uma coleção nova no app, declare-a acima; caso contrário ela
    // cai aqui e nada funciona (falha barulhenta, que é o comportamento certo).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
